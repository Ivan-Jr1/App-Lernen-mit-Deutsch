# Copie para .env e ajuste conforme necessário.

# SQLite local (padrão). Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:senha@host:5432/deutsch
DATABASE_URL=sqlite:///./deutsch.db

# Fuso usado para contabilizar o streak.
STUDY_TIMEZONE=Europe/Berlin

# Origens liberadas no CORS (JSON) — front local do Vite.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Regex para origens dinâmicas (URLs de preview da Vercel).
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Repovoar o banco na inicialização (útil no Render free tier, disco efêmero).
SEED_ON_STARTUP=false

# Chave de assinatura dos tokens JWT. Em produção gere algo aleatório e longo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-in-production-please
JWT_EXPIRE_DAYS=30
